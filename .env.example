# Copy to .env for local development. Never commit .env.
# Secrets in this file stay on the backend; Flutter never receives them.

APP_ENV=development
LOG_LEVEL=INFO

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_TIMEOUT_SECONDS=20
OPENAI_MAX_RETRIES=1
# Keep idle HTTPS connections open (SDK default is 5 s). Reconnecting costs ~0.5-1 s
# on the first call of each voice turn.
OPENAI_KEEPALIVE_SECONDS=120
# Open a connection at startup so the first customer doesn't wait for it.
OPENAI_WARMUP=true
# >0: refresh the connection every N seconds while idle (for long quiet periods).
OPENAI_KEEPWARM_INTERVAL_SECONDS=0

# --- Speech-to-text ---
# "openai" or "mock" (canned transcript, for development without audio).
STT_PROVIDER=openai
# Benchmarked 2026-10-06 on Burmese/English mixed kiosk sentences:
#   gpt-4o-transcribe     best Burmese (5/6 sentences correct), ~1.1 s
#   gpt-4o-mini-transcribe / gpt-transcribe: much worse on Burmese
OPENAI_STT_MODEL=gpt-4o-transcribe
OPENAI_STT_TIMEOUT_SECONDS=6
OPENAI_STT_TEMPERATURE=0
# Add catalog brand names to the recognition prompt.
STT_CATALOG_VOCABULARY=true

# --- Retail Store Assistant ---
# Benchmarked 2026-10-06: gpt-5.4-mini + effort none = best Burmese, ~1.2 s per LLM call.
OPENAI_AGENT_MODEL=gpt-5.4-mini
# Reasoning models only ("none", "minimal", "low", ...). Leave empty for gpt-4.1*.
OPENAI_AGENT_REASONING_EFFORT=none
OPENAI_AGENT_MAX_OUTPUT_TOKENS=500
# Per model call; a stalled call is retried once within AGENT_TIMEOUT_SECONDS.
OPENAI_AGENT_REQUEST_TIMEOUT_SECONDS=6
AGENT_TIMEOUT_SECONDS=15
AGENT_MAX_TURNS=4
# Render common answers (product location, hours, parking, BMI) from tool results in
# Python instead of a second LLM call: ~1-1.5 s faster, wording fixed.
AGENT_TEMPLATE_ANSWERS=true
# Agents SDK tracing uploads conversations to the OpenAI dashboard.
OPENAI_AGENTS_TRACING=false

# --- Text-to-speech ---
# Provider per language: "openai" or "mock" (silent WAV for development).
# Burmese quality with OpenAI is limited; TTS_PROVIDER_MY_MM lets Burmese move to
# another vendor later without touching English, the agent or Flutter.
TTS_PROVIDER=openai
TTS_PROVIDER_MY_MM=
TTS_PROVIDER_EN_US=
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=coral
# mp3 plays everywhere in Flutter; wav/pcm skip encoding but are much larger.
OPENAI_TTS_FORMAT=mp3
OPENAI_TTS_SPEED=1.0
OPENAI_TTS_TIMEOUT_SECONDS=15
# No audio within this time = stalled request; retried up to TTS_ATTEMPTS times.
TTS_FIRST_BYTE_TIMEOUT_SECONDS=4
TTS_ATTEMPTS=2
# Cache synthesized clips by exact text (template answers repeat verbatim). 0 = off.
TTS_CACHE_ENTRIES=300

# --- Conversation sessions (in memory) ---
SESSION_TTL_SECONDS=600
SESSION_MAX_TURNS=6

# --- Business data ---
# "google_sheets" = the sheet below; "mock" = CSV files in MOCK_DATA_DIR
BUSINESS_DATA_SOURCE=mock
MOCK_DATA_DIR=sample_data

# --- Google Sheets (POC business data) ---
GOOGLE_SHEETS_ID=
# Local dev: path to the service-account JSON. Empty = Application Default Credentials
# (on Cloud Run, the service's own service account; no key file needed).
GOOGLE_SERVICE_ACCOUNT_FILE=credentials/google-service-account.json
GOOGLE_SHEETS_TIMEOUT_SECONDS=10

# --- Trusted kiosk context defaults ---
DEFAULT_ORGANIZATION_ID=ORG-001
DEFAULT_STORE_ID=STORE-001

# --- Cache ---
# Data older than this is refreshed in the background (customers keep getting the
# cached copy meanwhile). Manual refresh: POST /admin/cache/refresh
CACHE_TTL_SECONDS=300
# After a failed load, wait this long before asking the source again.
CACHE_RETRY_SECONDS=15

# --- Admin endpoints (/admin/*) ---
# Empty: open in APP_ENV=development, hidden (404) elsewhere. Set to require X-Admin-Key.
ADMIN_API_KEY=

# --- Kiosk auth (X-Kiosk-Key header) ---
KIOSK_AUTH_ENABLED=false
# Comma-separated list of accepted kiosk keys
KIOSK_API_KEYS=

# --- Privacy ---
# Set true only in development; transcripts may contain customer speech.
LOG_TRANSCRIPTS=false

# --- Limits ---
MAX_AUDIO_BYTES=10485760
MAX_TTS_CHARS=1000
