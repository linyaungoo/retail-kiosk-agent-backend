# Non-secret settings for the local Docker deployment (docker-compose.yml).
# Loaded after .env (OpenAI key, Google Sheet, models) and before .env.docker
# (kiosk and admin keys), so these override your development .env.

APP_ENV=production
LOG_LEVEL=INFO
LOG_TRANSCRIPTS=false

# Kiosks must send X-Kiosk-Key (KIOSK_API_KEYS in .env.docker).
KIOSK_AUTH_ENABLED=true
# Switch to true once the Google Sheet has a KIOSKS tab; until then kiosks use
# DEFAULT_STORE_ID.
KIOSK_REGISTRY_REQUIRED=false

# Hands-free realtime voice, push-to-talk as the fallback.
VOICE_MODE=realtime
OPENAI_REALTIME_MODEL=gpt-realtime-2.1

# The web test console runs on this machine (python -m http.server 5500 --directory web).
CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
WEB_CONSOLE_ENABLED=false
